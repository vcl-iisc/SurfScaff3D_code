# Copy to .env and fill in. Do NOT commit the real .env.

# OpenRouter — for the generator and also used by the critic when CRITIC_PROVIDER=openrouter
OPENROUTER_API_KEY=

# Critic agent — Gemini 2.5 Pro
GEMINI_API_KEY=

# Critic VLM provider: "gemini" (Google direct, uses GEMINI_API_KEY)
#                    or "openrouter" (uses OPENROUTER_API_KEY)
CRITIC_PROVIDER=gemini
